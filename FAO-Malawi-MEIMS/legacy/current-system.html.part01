<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>FAO Malawi M&E Activity Tracker</title>
<style>
:root{--g:#143d2a;--a:#198754;--bg:#f5f7f9;--line:#e4e7ec;--muted:#667085}*{box-sizing:border-box}
body{margin:0;font:14px Segoe UI,Arial;background:var(--bg);color:#17212b}header{height:68px;background:var(--g);color:white;padding:13px 22px;display:flex;justify-content:space-between;align-items:center;position:sticky;top:0;z-index:5}.brand{font-weight:800}.brand small{display:block;font-weight:400;opacity:.75;font-size:11px}
button{border:0;border-radius:7px;padding:8px 12px;cursor:pointer;font-weight:600}.primary{background:var(--a);color:#fff}.secondary{background:#fff;color:var(--g)}.danger{background:#fee4e2;color:#b42318}
.layout{display:flex}aside{width:215px;background:#102f22;color:#dce9e2;position:fixed;top:68px;bottom:0;padding:15px 10px}nav button{width:100%;background:none;color:#dce9e2;text-align:left;margin:3px 0}.nav-active,nav button:hover{background:#1a4d37!important}
main{margin-left:215px;padding:24px;max-width:1600px;width:100%}.page{display:none}.page.active{display:block}h1{margin:0 0 5px;font-size:25px}.sub{color:var(--muted);margin-bottom:18px;font-size:13px}.cards{display:grid;grid-template-columns:repeat(5,1fr);gap:13px;margin-bottom:16px}.card,.panel{background:white;border:1px solid var(--line);border-radius:11px;padding:15px}.metric{font-size:27px;font-weight:800}.label{font-size:12px;color:var(--muted);margin-top:4px}.grid2{display:grid;grid-template-columns:1.2fr .8fr;gap:15px}.panel{margin-bottom:15px}.toolbar{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:12px}.toolbar input,.toolbar select,.form input,.form select,.form textarea{padding:9px;border:1px solid #d0d5dd;border-radius:7px;background:#fff}.toolbar input{width:250px}
.table-wrap{overflow:auto;max-height:62vh}table{border-collapse:collapse;width:100%;font-size:12px}th,td{padding:9px 8px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}th{background:#f8fafb;position:sticky;top:0}.bar{height:9px;background:#edf0f2;border-radius:9px;overflow:hidden}.bar i{display:block;height:100%;background:#198754}.badge{display:inline-block;padding:4px 7px;border-radius:99px;font-size:11px;font-weight:700;background:#eef2f6}.green{background:#dcfae6;color:#067647}.yellow{background:#fef0c7;color:#b54708}.red{background:#fee4e2;color:#b42318}.blue{background:#e0f2fe;color:#0369a1}.muted{color:var(--muted)}
.form{display:grid;grid-template-columns:1fr 1fr;gap:12px}.form label{font-size:12px;font-weight:700;color:#475467}.form label span{display:block;margin-bottom:5px}.full{grid-column:1/-1}.actions{display:flex;justify-content:flex-end;gap:8px;margin-top:14px}.modal{display:none;position:fixed;inset:0;background:#0007;z-index:20;align-items:center;justify-content:center}.modal.show{display:flex}.modalbox{background:#fff;width:94%;max-width:900px;max-height:90vh;overflow:auto;border-radius:12px;padding:20px}
.mini{background:#f8fafb;border-radius:8px;padding:12px;margin:8px 0}.kpi{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
@media(max-width:1000px){aside{width:65px}.nav-label{display:none}main{margin-left:65px}.cards{grid-template-columns:repeat(2,1fr)}.grid2{grid-template-columns:1fr}}@media(max-width:650px){.cards{grid-template-columns:1fr}.form{grid-template-columns:1fr}.full{grid-column:auto}main{padding:14px}}

.progress-wrap{display:flex;align-items:center;gap:7px;min-width:100px}.progress-text{font-weight:800;min-width:38px;text-align:right}.progress-complete{color:#067647}.progress-incomplete{color:#b42318}.progress-track{height:8px;background:#edf0f2;border-radius:8px;overflow:hidden;flex:1}.progress-complete-bar{height:100%;background:#12b76a}.progress-incomplete-bar{height:100%;background:#f04438}

.progress-wrap{display:flex;align-items:center;gap:7px;min-width:135px}
.progress-text{font-weight:800;min-width:38px;text-align:right}
.progress-track{height:8px;background:#f04438;border-radius:8px;overflow:hidden;display:flex;flex:1;min-width:80px}
.progress-complete-bar{height:100%;background:#12b76a}
.progress-incomplete-bar{height:100%;background:#f04438}

#dbProject{min-width:260px}
#budgetCards{grid-template-columns:repeat(3,1fr)}
@media(max-width:900px){#budgetCards{grid-template-columns:1fr}}

#modeBudget .bar{height:14px;margin-top:5px;background:#eaecf0;border-radius:8px;overflow:hidden}
#modeBudget .bar i,#projectBudget .bar i{display:block;height:100%;background:#12b76a;border-radius:8px}
#modeBudget b{font-weight:800}
</style></head><body>
<header><div class="brand">FAO Malawi — M&E Activity Tracker<small>Dynamic programme monitoring workspace</small></div>
<div><button class="secondary" onclick="openActivity()">+ Activity</button> <button class="secondary" onclick="openProject()">+ Project</button></div></header>
<div class="layout"><aside><nav><button class="nav-active" data-page="dashboard">▣ <span class="nav-label">Dashboard</span></button><button data-page="activities">☷ <span class="nav-label">Activity Tracker</span></button><button data-page="projects">▤ <span class="nav-label">Projects</span></button><button data-page="sessions">◷ <span class="nav-label">Review Sessions</span></button><button data-page="reports">▥ <span class="nav-label">Reports & Data</span></button></nav></aside>
<main>
<section id="dashboard" class="page active"><h1>Programme Dashboard</h1><div class="sub">Live summary of activities, delivery status, priorities and review actions.</div><div class="cards" id="cards"></div>
<div class="panel">
<h2>Budget Analysis</h2>
<div class="toolbar" style="margin-bottom:10px">
<label style="display:flex;align-items:center;gap:8px"><span style="font-weight:600">Filter by Project:</span>
<select id="dbProject" onchange="renderDashboard()"><option value="">All Projects</option></select></label>
</div>
<div class="cards" id="budgetCards" style="margin-bottom:0"></div>
</div>
<div class="grid2">
<div class="panel"><h2>Budget by Mode of Implementation</h2>
<div class="small" style="margin-bottom:10px">Source: Annual Programme Workplan 2026 — Entry hub, Column O: MODE OF IMPLEMENTATION.</div>
<div id="modeBudget"></div></div>
<div class="panel"><h2>Budget by Project</h2><div id="projectBudget"></div></div>
</div>
<div class="grid2"><div class="panel"><h2>Activity Status</h2><div id="status"></div></div><div class="panel"><h2>Priority / Attention</h2><div id="priority"></div></div></div><div class="panel"><h2>Activities Requiring Attention</h2><div class="table-wrap"><table><thead><tr><th>Project</th><th>Activity</th><th>Due</th><th>Status</th><th>Progress</th></tr></thead><tbody id="attention"></tbody></table></div></div></section>
<section id="activities" class="page"><h1>Activity Tracker</h1><div class="sub">Add, edit, delete, filter and update activities dynamically.</div><div class="toolbar"><input id="q" placeholder="Search project, activity, district..." oninput="renderActivities()"><select id="fp" onchange="renderActivities()"><option value="">All projects</option></select><select id="fs" onchange="renderActivities()"><option value="">All statuses</option><option>Not Started</option><option>In Progress</option><option>Completed</option><option>Delayed</option><option>Cancelled</option></select><select id="fpr" onchange="renderActivities()"><option value="">All priorities</option><option>High</option><option>Medium</option><option>Low</option></select><button class="primary" onclick="openActivity()">+ New Activity</button></div><div class="panel table-wrap"><table><thead><tr><th>Project</th><th>Output</th><th>Activity</th><th>Start</th><th>End</th><th>Status</th><th>Progress</th><th>Priority</th><th>Actions</th></tr></thead><tbody id="atable"></tbody></table></div></section>
<section id="projects" class="page"><h1>Projects</h1><div class="sub">Create and manage project records.</div><div class="toolbar"><input id="pq" placeholder="Search projects..." oninput="renderProjects()"><button class="primary" onclick="openProject()">+ New Project</button></div><div class="panel table-wrap"><table><thead><tr><th>Project</th><th>Title</th><th>FOUR BETTER</th><th>CPF Thematic Area</th><th>CPF Output</th><th>Manager</th><th>M&E Focal</th><th>Activities</th><th>Actions</th></tr></thead><tbody id="ptable"></tbody></table></div></section>
<section id="sessions" class="page"><h1>Interactive Review Sessions</h1><div class="sub">Record monthly, quarterly, project or ad-hoc reviews, decisions and follow-up actions.</div><button class="primary" onclick="openSession()">+ New Review Session</button><div id="sessionsList" style="margin-top:12px"></div></section>
<section id="reports" class="page"><h1>Reports & Data</h1><div class="sub">Export the live tracker or restore a backup. Prototype data is stored in browser localStorage.</div><div class="panel"><h2>Data Management</h2><p class="muted">Initial data is seeded from the latest supplied 2026 Annual Programme Workplan, Entry hub sheet. Activity dates use the latest workbook Column M (Activity Start Date) and Column N (Activity End Date) values, and Activity Status is captured as a dedicated variable. Project-level FOUR BETTER, CPF Thematic Area and CPF Output use pull-down lists from the supplied workplan; CPF Output is dynamically filtered by the selected CPF Thematic Area.</p><button class="primary" onclick="exportJSON()">Export JSON Backup</button> <button onclick="exportCSV()">Export Activities CSV</button> <button onclick="document.getElementById('imp').click()">Import JSON Backup</button> <input id="imp" type="file" accept=".json" style="display:none" onchange="importJSON(event)"> <button class="danger" onclick="resetData()">Reset to supplied workplan</button></div><div class="panel"><h2>Production-ready architecture</h2><div class="kpi"><div class="mini"><b>Dynamic registry</b><br><span class="muted">Projects, outputs and activities</span></div><div class="mini"><b>Workflow layer</b><br><span class="muted">Updates, reviews and approvals</span></div><div class="mini"><b>Integration layer</b><br><span class="muted">Kobo/IDEA, GIS, APIs and PRIMO</span></div></div></div></section>
</main></div><div class="modal" id="modal"><div class="modalbox" id="modalbox"></div></div>
<script>
const SEED={"projects":[{"code":"OSRO_MLW_097_JPN","title":"Supporting El Niño affected farming communities in the southern region of Malawi through emergency agriculture-based interventions to enhance food production and safeguard lives and livelihoods of the affected population.","fourBetter":"Better Production","cpfThematic":"AFST","cpfOutput":"1.1: Improved food and nutrition security","manager":"","meFocal":"","startDate":"","endDate":"","status":"Active"},{"code":"UNJP_MLW_089_EC","title":"Malawi - Enable effective disaster risk management through systems for inter-agency anticipatory action using a multi-hazard, multi-sectoral approach - 2023","fourBetter":"Better Life","cpfThematic":"IREPRR","cpfOutput":"3.2: Strengthened disaster risk management capacities of households, communities and national and local institutions","manager":"","meFocal":"","startDate":"","endDate":"","status":"Active"},{"code":"TCP_MLW_4001","title":"Improving Capacity and Technical Support towards Anchor Mega Farms","fourBetter":"Better Production","cpfThematic":"AFST","cpfOutput":"1.2: Improved Agricultural productivity and infrastructure","manager":"","meFocal":"","startDate":"","endDate":"","status":"Active"},{"code":"FVC_GLO_191_MUL","title":"\"E-empowerment\" of small-scale producers: leveraging digital tools sustainably in Farmer Field Schools (FFS)","fourBetter":"Better Production","cpfThematic":"AFST","cpfOutput":"1.2: Improved Agricultural productivity and infrastructure","manager":"","meFocal":"","startDate":"","endDate":"","status":"Active"},{"code":"OSRO_MLW_096_CHA","title":"Restore and improve food production and agricultural livelihoods of El Niño impacted farming households through Cash and Voucher Assistance and climate smart agriculture in Dowa, Chikwawa and Nsanje districts","fourBetter":"Better Life","cpfThematic":"IREPRR","cpfOutput":"3.1: Enhanced resilience to climate shocks of rural populations reliant on agriculture","manager":"","meFocal":"","startDate":"","e