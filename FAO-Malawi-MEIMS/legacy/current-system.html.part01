utrition security","projectOutput":"Output5: Regular monitoring and technical backstopping of agricultural production activities in the project locations undertaken.","activity":"Undertake regular monitoring and technical backstopping of agricultural production activities in the project locations.","manager":"","meFocal":"","approver":"","startDate":"2026-03-02","endDate":"2026-03-24","mode":"E-Payment","districts":"","budget":"15231","status":"Not Started","progress":0,"priority":"Medium","update":"","lastUpdated":""},{"id":"A0006","projectCode":"UNJP_MLW_089_EC","projectTitle":"Malawi - Enable effective disaster risk management through systems for inter-agency anticipatory action using a multi-hazard, multi-sectoral approach - 2023","fourBetter":"Better Life","cpfThematic":"IREPRR","cpfOutput":"3.2: Strengthened disaster risk management capacities of households, communities and national and local institutions","projectOutput":"Output 2: Triggers for AA are developed, collaboration between forecasters is enhanced and capacity building for impact-based forecasting is supported while disaster risk financing (DRF) analyses is enhanced, existing financing instruments for AA are aligned and further DRF instruments expanded.","activity":"Procurement of weather monitoring equipment","manager":"","meFocal":"","approver":"","startDate":"2026-01-02","endDate":"2026-02-19","mode":"Procurement","districts":"Phalombe","budget":"40000","status":"Not Started","progress":0,"priority":"Medium","update":"","lastUpdated":""},{"id":"A0007","projectCode":"UNJP_MLW_089_EC","projectTitle":"Malawi - Enable effective disaster risk management through systems for inter-agency anticipatory action using a multi-hazard, multi-sectoral approach - 2024","fourBetter":"Better Life","cpfThematic":"IREPRR","cpfOutput":"3.2: Strengthened disaster risk management capacities of households, communities and national and local institutions","projectOutput":"Output 3: A crisis modifier to fund and/or scale-up AA activations and disaster response along the project running period","activity":"Conduct anticipatory cash transfers for simulation exercise","manager":"","meFocal":"","approver":"","startDate":"2026-02-20","endDate":"2026-03-12","mode":"Mobile Cash Transfer","districts":"Phalombe","budget":"200000","status":"Not Started","progress":0,"priority":"Medium","update":"","lastUpdated":""},{"id":"A0008","projectCode":"UNJP_MLW_089_EC","projectTitle":"Malawi - Enable effective disaster risk management through systems for inter-agency anticipatory action using a multi-hazard, multi-sectoral approach - 2026","fourBetter":"Better Life","cpfThematic":"IREPRR","cpfOutput":"3.2: Strengthened disaster risk management capacities of households, communities and national and local institutions","projectOutput":"Output 1: Robust multi-actor and multi-sectoral frameworks for Anticipatory Action (AA) coordination are established and AA operations are carried out in a harmonised manner, supported by learning, research and piloting to advocate for a system wide shift from reaction to anticipation in Malawi","activity":"Conduct end of project review and handover workshops in Blantyre and Phalombe","manager":"","meFocal":"","approver":"","startDate":"2026-03-13","endDate":"2026-03-19","mode":"LTA","districts":"Blantyre and Phalombe","budget":"4000","status":"Not Started","progress":0,"priority":"Medium","update":"","lastUpdated":""},{"id":"A0009","projectCode":"TCP_MLW_4001","projectTitle":"Improving Capacity and Technical Support towards Anchor Mega Farms","fourBetter":"Better Production","cpfThematic":"AFST","cpfOutput":"1.2: Improved Agricultural productivity and infrastructure","projectOutput":"Capacity of ancor mega farmers in irrigation practices, water and soil conservation practices, livestock production, crop production and commercialization enhanced","activity":"Conduct technical trainings in irrigation practices, water and soil conservation practices, livestock production, c