function loadDB(){
  try{
    const saved=JSON.parse(localStorage.getItem(KEY)||"null");
    if(saved && Array.isArray(saved.projects) && Array.isArray(saved.activities) && saved.activities.length>=400 && saved.activities.some(a=>a.mode)) return saved;
  }catch(e){}
  return JSON.parse(JSON.stringify(SEED));
}
const FOUR_BETTERS=["Better Production", "Better Nutrition", "Better Environment", "Better Life"];const THEMATIC_AREAS=["ConduciveAgriculture", "FoodSecurity", "ImprovedGovernance", "Resilience"];const CPF_OUTPUTS={"ConduciveAgriculture": [], "FoodSecurity": [], "ImprovedGovernance": [], "Resilience": []};let db=loadDB();
const $=id=>document.getElementById(id), esc=x=>String(x??"").replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[m]));
function save(){try{localStorage.setItem(KEY,JSON.stringify(db))}catch(e){}render()}
function progressHTML(v){
  v=Math.max(0,Math.min(100,+v||0));
  const remaining=100-v;
  return `<div class="progress-wrap">
    <span class="progress-text">${v}%</span>
    <div class="progress-track" title="${v}% completed, ${remaining}% remaining">
      <div class="progress-complete-bar" style="width:${v}%"></div>
      <div class="progress-incomplete-bar" style="width:${remaining}%"></div>
    </div>
  </div>`;
}
function badge(s){let c=s==="Completed"?"green":s==="Delayed"?"red":s==="In Progress"?"blue":"yellow";return `<span class="badge ${c}">${esc(s)}</span>`}
function render(){renderDashboard();renderActivities();renderProjects();renderSessions();fillProjects()}
function days(d){return d?Math.ceil((new Date(d)-new Date())/864e5):99999}
function renderDashboard(){
  let a=db.activities,n=a.length,done=a.filter(x=>x.status==="Completed").length,del=a.filter(x=>x.status==="Delayed").length,avg=n?Math.round(a.reduce((s,x)=>s+(+x.progress||0),0)/n):0;
  $("cards").innerHTML=[["Activities",n],["Projects",db.projects.length],["Completed",done],["Delayed",del],["Avg. Progress",avg+"%"]].map(x=>`<div class="card"><div class="metric">${x[1]}</div><div class="label">${x[0]}</div></div>`).join("");

  // Dashboard budget filter
  const sel=$("dbProject"), old=sel.value;
  sel.innerHTML='<option value="">All Projects</option>'+db.projects.map(p=>`<option value="${esc(p.code)}">${esc(p.code)}</option>`).join("");
  if([...sel.options].some(o=>o.value===old)) sel.value=old;
  const projectFilter=sel.value;
  const ba=projectFilter?a.filter(x=>x.projectCode===projectFilter):a;
  const totalBudget=ba.reduce((sum,x)=>sum+(numBudget(x.budget)||0),0);
  $("budgetCards").innerHTML=[
    ["Total Budget",money(totalBudget)],
    ["Budgeted Activities",ba.filter(x=>(numBudget(x.budget)||0)>0).length],
    ["Selected Project",projectFilter||"All Projects"]
  ].map(x=>`<div class="card"><div class="metric" style="font-size:${x[0]==="Selected Project"?"18px":"25px"}">${esc(x[1])}</div><div class="label">${esc(x[0])}</div></div>`).join("");

  // Budget by mode of implementation
  const modes={};
  ba.forEach(x=>{let mode=(x.mode||"Not Specified").replace(/\s+/g," ").trim()||"Not Specified";modes[mode]=(modes[mode]||0)+(numBudget(x.budget)||0)});
  const modeRows=Object.entries(modes).sort((a,b)=>b[1]-a[1]);
  const modeMax=modeRows.length?modeRows[0][1]:0;
  $("modeBudget").innerHTML=modeRows.length?modeRows.map(([mode,val])=>{
    let pct=totalBudget?Math.round(val/totalBudget*100):0;
    let width=modeMax?Math.round(val/modeMax*100):0;
    return `<div style="margin:14px 0">
      <div style="display:flex;justify-content:space-between;gap:10px"><span><b>${esc(mode)}</b></span><span><b>${money(val)}</b> (${pct}%)</span></div>
      <div class="bar"><i style="width:${width}%"></i></div>
    </div>`;
  }).join(""):"<div class='muted'>No budget data available.</div>";

  // Budget by project (when all projects selected)
  const projects={};
  ba.forEach(x=>{let code=x.projectCode||"Unassigned";projects[code]=(projects[code]||0)+(numBudget(x.budget)||0)});
  const projectRows=Object.entries(projects).sort((a,b)=>b[1]-a[1]);
  const projectMax=projectRows.length?projectRows[0][1]:0;
  $("projectBudget").innerHTML=projectRows.length?projectRows.map(([code,val])=>{
    let pct=totalBudget?Math.round(val/totalBudget*100):0;
    let width=projectMax?Math.round(val/projectMax*100):0;
    return `<div style="margin:10px 0">
      <div style="display:flex;justify-content:space-between;gap:8px"><span>${esc(code)}</span><span><b>${money(val)}</b> (${pct}%)</span></div>
      <div class="bar"><i style="width:${width}%"></i></div>
    </div>`;
  }).join(""):"<div class='muted'>No budget data available.</div>";

  let ss=["Not Started","In Progress","Completed","Delayed","Cancelled"];$("status").innerHTML=ss.map(s=>{let z=a.filter(x=>x.status===s).length,p=n?Math.round(z/n*100):0;return `<div style="margin:9px 0"><div style="display:flex;justify-content:space-between"><span>${s}</span><b>${z}</b></div><div class="bar"><i style="width:${p}%"></i></div></div>`}).join("");
  $("priority").innerHTML=["High","Medium","Low"].map(s=>`<div class="mini"><b>${a.filter(x=>x.priority===s).length}</b> &nbsp; ${s} priority activities</div>`).join("");
  let at=a.filter(x=>x.status==="Delayed"||x.priority==="High"||((+x.progress||0)<50&&days(x.endDate)<15)).slice(0,20);$("attention").innerHTML=at.map(x=>`<tr><td>${esc(x.projectCode)}</td><td>${esc(x.activity)}</td><td>${esc(x.endDate)}</td><td>${badge(x.status)}</td><td>${progressHTML(x.progress)}</td></tr>`).join("")||"<tr><td colspan=5>No activities currently flagged.</td></tr>";
}
function numBudget(v){
  if(typeof v==="number") return isFinite(v)?v:0;
  let t=String(v??"").trim().replace(/\\s/g,"");
  if(!t) return 0;
  // Handle values such as 6 853,22 and 313,614.
  if(t.includes(",") && t.includes(".")){
    if(t.lastIndexOf(",")>t.lastIndexOf(".")) t=t.replace(/\\./g,"").replace(",",".");
    else t=t.replace(/,/g,"");
  }else if(t.includes(",")){
    const parts=t.split(",");
    t=parts[parts.length-1].length===2?t.replace(",","."):t.replace(/,/g,"");
  }
  return parseFloat(t)||0;
}
function money(v){
  return "$"+numBudget(v).toLocaleString("en-US",{minimumFractionDigits:2,maximumFractionDigits:2});
}
function fillProjects(){let v=$("fp").value;$("fp").innerHTML='<option value="">All projects</option>'+db.projects.map(p=>`<option>${esc(p.code)}</option>`).join("");$("fp").value=v}
function renderActivities(){let q=($("q")?.value||"").toLowerCase(),p=$("fp")?.value||"",s=$("fs")?.value||"",pr=$("fpr")?.value||"";let a=db.activities.filter(x=>(!q||[x.projectCode,x.projectTitle,x.activity,x.districts,x.projectOutput].join(" ").toLowerCase().includes(q))&&(!p||x.projectCode===p)&&(!s||x.status===s)&&(!pr||x.priority===pr));$("atable").innerHTML=a.map(x=>`<tr><td><b>${esc(x.projectCode)}</b></td><td>${esc(x.projectOutput).slice(0,85)}</td><td>${esc(x.activity)}</td><td>${esc(x.startDate)}</td><td>${esc(x.endDate)}</td><td>${badge(x.status)}</td><td>${progressHTML(x.progress)}</td><td>${esc(x.priority)}</td><td><button onclick="openActivity('${x.id}')">Edit</button> <button class="danger" onclick="delActivity('${x.id}')">Delete</button></td></tr>`).join("")||"<tr><td colspan=9>No activities found.</td></tr>"}
function openActivity(id=""){let x=id?db.activities.find(a=>a.id===id):{projectCode:db.projects[0]?.code||"",activity:"",projectOutput:"",fourBetter:db.projects[0]?.fourBetter||"",cpfThematic:db.projects[0]?.cpfThematic||"",cpfOutput:db.projects[0]?.cpfOutput||"",startDate:"",endDate:"",status:"Not Started",priority:"Medium",progress:0,mode:"",districts:"",budget:0,meFocal:"",update:""};$("modalbox").innerHTML=`<h2>${id?"Edit Activity":"New Activity"}</h2><div class="form"><label><span>Project *</span><select id="ap">${db.projects.map(p=>`<option ${p.code===x.projectCode?"selected":""}>${esc(p.code)}</option>`).join("")}</select></label><label><span>Activity *</span><input id="aa" value="${esc(x.activity)}"></label><label><span>A — FOUR BETTER (from project)</span><select id="atfb" disabled><option>${esc(x.fourBetter||"")}</option></select></label><label><span>B — NEW CPF THEMATIC AREA (from project)</span><select id="atct" disabled><option>${esc(x.cpfThematic||"")}</option></select></label><label class="full"><span>C — NEW CPF OUTPUT (from project)</span><select id="atco" disabled><option>${esc(x.cpfOutput||"")}</option></select></label><label class="full"><span>Project Output</span><input id="ao" value="${esc(x.projectOutput)}"></label><label><span>CPF Thematic Area</span><input id="at" value="${esc(x.cpfThematic)}"></label><label><span>CPF Output</span><input id="ac" value="${esc(x.cpfOutput)}"></label><label><span>Activity Start Date</span><input id="as" type="date" value="${esc(x.startDate)}"></label><label><span>Activity End Date</span><input id="ae" type="date" value="${esc(x.endDate)}"></label><label><span>Activity Status</span><select id="ast"><option value="">Select status</option>${["Not Started","In Progress","Completed","Delayed","On Hold","Cancelled"].map(s=>`<option ${s===x.status?"selected":""}>${s}</option>`).join("")}<option value="__custom">Other / Custom</option></select></label><label><span>Custom Activity Status</span><input id="asc" placeholder="Enter another status if required" value="${esc(x.status && !["Not Started","In Progress","Completed","Delayed","On Hold","Cancelled"].includes(x.status)?x.status:"")}"></label><label><span>Priority</span><select id="apr">${["High","Medium","Low"].map(s=>`<option ${s===x.priority?"selected":""}>${s}</option>`).join("")}</select></label><label><span>Activity Progress (%)</span><input id="ag" type="number" min="0" max="100" value="${x.progress||0}"></label><label><span>Mode of Implementation</span><input id="am" value="${esc(x.mode)}"></label><label><span>Districts</span><input id="ad" value="${esc(x.districts)}"></label><label><span>Budget (USD)</span><input id="ab" type="number" value="${x.budget||0}"></label><label><span>M&E Focal Point</span><input id="af" value="${esc(x.meFocal)}"></label><label class="full"><span>Progress Update / Comment</span><textarea id="au" rows="4">${esc(x.update)}</textarea></label></div><div class="actions"><button onclick="closeModal()">Cancel</button><button class="primary" onclick="saveActivity('${id}')">Save Activity</button></div>`;$("modal").classList.add("show");
  const statusControl=$("ast"), progressControl=$("ag");
  function syncStatusProgress(){
    if(!statusControl||!progressControl)return;
    if(statusControl.value==="Completed"){progressControl.value=100;progressControl.readOnly=true;}
    else if(statusControl.value==="Not Started"||statusControl.value==="Cancelled"){progressControl.value=0;progressControl.readOnly=true;}
    else progressControl.readOnly=false;
  }
  statusControl.addEventListener("change",syncStatusProgress);
  syncStatusProgress();let ast=$("ast");if(ast && !Array.from(ast.options).some(o=>o.value===x.status)){ast.value="__